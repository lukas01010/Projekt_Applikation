# ==========================================
# UI DRAWING HELPERS (MODERN DESIGN SYSTEM)
# ==========================================
def draw_card(x, y, w, h, bg_col=(255, 255, 255), border_col=(226, 232, 240), radius=16):
    py5.stroke(*border_col)
    py5.stroke_weight(1.5)
    py5.fill(*bg_col)
    py5.rect(x, y, w, h, radius)


def draw_button(x, y, w, h, label, sublabel="", active=False):
    is_hovered = (x <= py5.mouse_x <= x + w) and (y <= py5.mouse_y <= y + h)

    if active:
        fill_col = (79, 70, 229)      # Indigo Accent
        text_col = (255, 255, 255)
        border_col = (67, 56, 202)
    elif is_hovered:
        fill_col = (238, 242, 255)    # Light Indigo Hover
        text_col = (67, 56, 202)
        border_col = (199, 210, 254)
    else:
        fill_col = (255, 255, 255)
        text_col = (30, 41, 59)       # Dark Slate Text
        border_col = (226, 232, 240)

    py5.stroke(*border_col)
    py5.stroke_weight(2 if (is_hovered or active) else 1)
    py5.fill(*fill_col)
    py5.rect(x, y, w, h, 14)

    py5.text_align(py5.CENTER, py5.CENTER)
    py5.fill(*text_col)
    py5.text_size(17)
    py5.text(label, x + w / 2, y + (h / 2 - 10 if sublabel else h / 2))

    if sublabel:
        py5.text_size(12)
        py5.fill(148, 163, 184) if not active else py5.fill(224, 231, 255)
        py5.text(sublabel, x + w / 2, y + h / 2 + 12)

    return is_hovered


def draw_header(title, subtitle=""):
    draw_card(40, 20, 1020, 70, (255, 255, 255), (226, 232, 240), 12)
    py5.text_align(py5.LEFT, py5.CENTER)
    py5.fill(15, 23, 42)
    py5.text_size(22)
    py5.text(title, 60, 45 if subtitle else 55)

    if subtitle:
        py5.fill(100, 116, 139)
        py5.text_size(13)
        py5.text(subtitle, 60, 68)

    # Zurück-Button
    if app_state != "MENU":
        draw_button(920, 32, 120, 44, "Hauptmenü", "[ESC]")


