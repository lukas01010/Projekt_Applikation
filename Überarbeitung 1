def draw_tree_screen():
    draw_header(f"Primfaktorbaum für {num1}", f"Stufe {current_tree_step} von {max_tree_steps} aufgedeckt | Klicke für den nächsten Schritt")

    # Baum-Darstellungsbereich
    draw_card(40, 105, 1020, 610, (255, 255, 255), (226, 232, 240), 16)

    if tree_root:
        draw_node_recursive(tree_root, current_tree_step)

    # Interaktive Steuerung unten
    py5.text_align(py5.CENTER, py5.CENTER)
    py5.fill(100, 116, 139)
    py5.text_size(14)
    if current_tree_step < max_tree_steps:
        py5.text("Klicke irgendwo in das Fenster, um die nächste Stufe anzuzeigen", 550, 690)
    else:
        py5.fill(16, 185, 129)
        py5.text("Vollständig zerlegt! Klicke auf 'Hauptmenü' oder drücke ESC für eine neue Berechnung.", 550, 690)


def draw_node_recursive(node, max_step):
    if not node or node.step_idx > max_step:
        return

    # Linien zu Kindern zeichnen
    py5.stroke_weight(2)
    py5.stroke(148, 163, 184)

    if node.left and node.left.step_idx <= max_step:
        py5.line(node.x, node.y, node.left.x, node.left.y)
        draw_node_recursive(node.left, max_step)

    if node.right and node.right.step_idx <= max_step:
        py5.line(node.x, node.y, node.right.x, node.right.y)
        draw_node_recursive(node.right, max_step)

    # Knotenkreis zeichnen
    if node.is_prime:
        fill_col = (16, 185, 129)    # Emerald Green für Primzahlen
        border_col = (5, 150, 105)
    else:
        fill_col = (79, 70, 229)     # Indigo Accent für zusammengesetzte Zahlen
        border_col = (67, 56, 202)

    py5.stroke(*border_col)
    py5.stroke_weight(2)
    py5.fill(*fill_col)
    py5.ellipse(node.x, node.y, 52, 52)

    # Zahlenwert im Knoten
    py5.fill(255)
    py5.text_align(py5.CENTER, py5.CENTER)
    py5.text_size(16)
    py5.text(str(node.value), node.x, node.y)


