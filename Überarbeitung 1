# ==========================================
# DATA STRUCTURES & ALGORITHMS
# ==========================================
class FactorNode:
    def __init__(self, value, x, y, step_idx):
        self.value = value
        self.x = x
        self.y = y
        self.left = None
        self.right = None
        self.step_idx = step_idx
        self.is_prime = True


def is_prime(n):
    if n < 2:
        return False
    for i in range(2, int(n**0.5) + 1):
        if n % i == 0:
            return False
    return True


def get_prime_factors(n):
    factors = []
    d = 2
    temp = n
    while d * d <= temp:
        while temp % d == 0:
            factors.append(d)
            temp //= d
        d += 1
    if temp > 1:
        factors.append(temp)
    return factors


def build_factor_tree(n, x, y, dx, step_counter):
    node = FactorNode(n, x, y, step_counter[0])

    if is_prime(n) or n <= 1:
        node.is_prime = True
        return node

    node.is_prime = False
    d = 2
    while d * d <= n:
        if n % d == 0:
            break
        d += 1

    remainder = n // d

    # Linker Ast (Primfaktor)
    step_counter[0] += 1
    left_node = FactorNode(d, x - dx, y + 80, step_counter[0])
    left_node.is_prime = True
    node.left = left_node

    # Rechter Ast (Restquotient)
    step_counter[0] += 1
    next_dx = max(35, dx * 0.6)
    node.right = build_factor_tree(remainder, x + dx, y + 80, next_dx, step_counter)

    return node


def count_tree_steps(node):
    if not node:
        return 0
    max_s = node.step_idx
    if node.left:
        max_s = max(max_s, count_tree_steps(node.left))
    if node.right:
        max_s = max(max_s, count_tree_steps(node.right))
    return max_s


def gcd(a, b):
    while b:
        a, b = b, a % b
    return a


def lcm(a, b):
    if a == 0 or b == 0:
        return 0
    return (a * b) // gcd(a, b)


