    py5.text(f"{num1} = " + " × ".join(map(str, factors_1)), 70, 295)

    # Karte 2 Inhalt
    py5.fill(15, 23, 42)
    py5.text_size(20)
    py5.text(f"Primfaktorzerlegung von {num2}", 595, 255)
    py5.fill(79, 70, 229)
    py5.text_size(22)
    py5.text(f"{num2} = " + " × ".join(map(str, factors_2)), 595, 295)

    # Rechenschritte & Erklärungen
    py5.fill(71, 85, 105)
    py5.text_size(15)
    y_pos = 360
    for step in calc_steps:
        py5.text(f"• {step}", 70, y_pos)
        y_pos += 35


# ==========================================
# EVENT HANDLING
# ==========================================
def mouse_pressed():
    global app_state, selected_mode, current_tree_step, active_slot

    # Hauptmenü Button oben rechts prüfen
    if app_state != "MENU" and (920 <= py5.mouse_x <= 1040) and (32 <= py5.mouse_y <= 76):
        reset_to_menu()
        return

    if app_state == "MENU":
        for i in range(3):
            y = 120 + i * 110
            if 40 <= py5.mouse_x <= 1060 and y <= py5.mouse_y <= y + 95:
                selected_mode = i + 1
                app_state = "INPUT"
                active_slot = 1
                return

    elif app_state == "INPUT":
        # Slot-Wechsel bei Klick
        if 250 <= py5.mouse_x <= 850:
            if 180 <= py5.mouse_y <= 250:
                active_slot = 1
            elif selected_mode in [2, 3] and 270 <= py5.mouse_y <= 340:
                active_slot = 2

        # Start Button
        btn_y = 370 if selected_mode in [2, 3] else 280
        if 250 <= py5.mouse_x <= 850 and btn_y <= py5.mouse_y <= btn_y + 55:
            process_input()

    elif app_state == "VIEW_TREE":
        if current_tree_step < max_tree_steps:
            current_tree_step += 1


def key_pressed():
    global app_state, input_val_1, input_val_2, active_slot, current_tree_step

    if py5.key == "\x1b":  # ESC Taste
        reset_to_menu()
        return

    if app_state == "INPUT":
        if py5.key in "0123456789":
            if active_slot == 1:
                input_val_1 += py5.key
            else:
                input_val_2 += py5.key
        elif py5.key in ["\x08", "\x7f"]:  # Backspace
            if active_slot == 1:
                input_val_1 = input_val_1[:-1]
            else:
                input_val_2 = input_val_2[:-1]
        elif py5.key == "\t":  # Tabulator für Feldwechsel
            if selected_mode in [2, 3]:
                active_slot = 2 if active_slot == 1 else 1
        elif py5.key in ["\n", "\r"]:  # Enter
            process_input()

    elif app_state == "VIEW_TREE":
        if py5.key == " ":
            if current_tree_step < max_tree_steps:
                current_tree_step += 1


def process_input():
    global app_state, num1, num2, tree_root, current_tree_step, max_tree_steps
    global calc_result, calc_steps, factors_1, factors_2

    if selected_mode == 1:
        if input_val_1 and input_val_1.isdigit() and int(input_val_1) >= 2:
            num1 = int(input_val_1)
            step_ptr = [0]
            tree_root = build_factor_tree(num1, 550, 160, 220, step_ptr)
            max_tree_steps = count_tree_steps(tree_root)
            current_tree_step = 0
            app_state = "VIEW_TREE"

    elif selected_mode in [2, 3]:
        if input_val_1.isdigit() and input_val_2.isdigit():
            num1 = int(input_val_1)
            num2 = int(input_val_2)

            if num1 >= 1 and num2 >= 1:
                factors_1 = get_prime_factors(num1)
                factors_2 = get_prime_factors(num2)
                calc_steps = []

                if selected_mode == 2:
                    calc_result = gcd(num1, num2)
                    calc_steps.append("Der ggT ist das Produkt aller gemeinsamen Primfaktoren.")
                    calc_steps.append(f"Gemeinsame Teiler: {calc_result}")
                else:
                    calc_result = lcm(num1, num2)
                    calc_steps.append("Formel: kgV(a, b) = (a × b) / ggT(a, b)")
                    calc_steps.append(f"ggT({num1}, {num2}) = {gcd(num1, num2)}")
                    calc_steps.append(f"Rechnung: ({num1} × {num2}) / {gcd(num1, num2)}")

                app_state = "VIEW_CALC"


def reset_to_menu():
    global app_state, selected_mode, input_val_1, input_val_2, num1, num2, tree_root
    app_state = "MENU"
    selected_mode = None
    input_val_1 = ""
    input_val_2 = ""
    num1 = None
    num2 = None
    tree_root = None


# ==========================================
# SKETCH EXECUTION
# ==========================================
py5.run_sketch()